    <ui:VisualElement name="TradeOverlay" class="monopoly-overlay popup-root trade-root" style="right: 0; max-width: 1080px; min-width: 90%; min-height: 107px; max-height: 1878px; height: 1627px; width: 1080px; top: 114px;">
